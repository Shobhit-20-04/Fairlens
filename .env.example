# FairLens Environment Configuration Example
# Copy this file to .env and populate your private keys.
# NEVER commit .env to version control.

# Application Environment
FAIRLENS_ENV=development
FAIRLENS_LOG_LEVEL=INFO
FAIRLENS_OFFLINE_MODE=true

# OpenRouter API (Auditing Nemotron 3 Ultra)
# Endpoint: https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_CACHE_DIR=.fairlens_cache/openrouter

# Cost Estimation & Spending Limits (USD)
FAIRLENS_MAX_SPEND_USD=5.00
FAIRLENS_WARN_SPEND_USD=2.00
# Reference pricing per 1M tokens (verify against current OpenRouter card)
OPENROUTER_INPUT_PRICE_PER_M=0.60
OPENROUTER_OUTPUT_PRICE_PER_M=3.60

# Discovery Engine Provider Credentials (Optional)
# Hugging Face Hub (Read Token)
HUGGINGFACE_TOKEN=
# Kaggle API credentials (username and key, or ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Data.gov API Key
DATA_GOV_API_KEY=
# Zenodo Access Token
ZENODO_ACCESS_TOKEN=

# Discovery Engine Cache Settings
DISCOVERY_CACHE_DIR=.fairlens_cache/discovery
DISCOVERY_CACHE_TTL_HOURS=24
